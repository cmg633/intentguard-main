# IntentGuard Environment Configuration (Template)
# Copy this file to .env.local and populate with your test credentials.
# NEVER commit .env.local or real secrets to version control.

# Session secret (random string for session cookie verification)
SESSION_SECRET=your_random_session_secret_here

# Autonomous LLM Provider Configuration
# Supported: "openai-compatible", "openai", or "none" (deterministic sandbox fallback)
# For Google Gemini (OpenAI-compatible endpoint):
LLM_PROVIDER=openai-compatible
LLM_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-flash-lite-latest
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Alternative: Standard OpenAI
# LLM_PROVIDER=openai
# LLM_API_KEY=your_openai_api_key_here
# LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=https://api.openai.com/v1

# Server-only Razorpay TEST Sandbox credentials (STRICTLY TEST MODE - Never use live keys)
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=your_test_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_test_webhook_secret_here

# Payment & App Environment Mode
PAYMENT_MODE=TEST
NEXT_PUBLIC_APP_ENV=demo

# Optional Database & Cache (IntentGuard defaults to built-in local store if omitted)
# DATABASE_URL=postgresql://intentguard:intentguard@localhost:5432/intentguard
# REDIS_URL=redis://localhost:6379